{
  "name": "synerpulse",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "SynerPulse \u2014 collaborative, anticipatory household finance platform (from 'Revolutionizing Household Finance', HCII 2025).",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs blank",
    "demo": "node scripts/dev.mjs demo",
    "demo:reset": "node scripts/dev.mjs demo-reset",
    "dev:servers": "concurrently -n api,web -c green,blue \"npm:dev -w @synerpulse/api\" \"npm:dev -w @synerpulse/web\"",
    "dev:api": "npm run dev -w @synerpulse/api",
    "dev:web": "npm run dev -w @synerpulse/web",
    "db:migrate": "npm run db:migrate -w @synerpulse/api",
    "db:seed": "npm run db:seed -w @synerpulse/api",
    "db:reset": "npm run db:reset -w @synerpulse/api",
    "build": "npm run build -w @synerpulse/web && npm run build -w @synerpulse/api",
    "start": "npm run start -w @synerpulse/api",
    "test": "npm run test -w @synerpulse/shared && npm run test -w @synerpulse/api && npm run test -w @synerpulse/web",
    "test:e2e": "npm run test:e2e -w @synerpulse/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w @synerpulse/shared && npm run typecheck -w @synerpulse/api && npm run typecheck -w @synerpulse/web",
    "test:pg": "npm run test:pg -w @synerpulse/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
