{
  "name": "@synerpulse/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/migrate.js && node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "db:reset": "tsx src/db/reset-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "db:migrate:prod": "node dist/migrate.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "papaparse": "^5.7.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.20",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
