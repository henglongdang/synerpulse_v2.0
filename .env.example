# FamilyPulse API configuration. Copy to apps/api/.env (or set as environment variables).
# Every value is optional in development; defaults are shown.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Leave unset in development to use the embedded PGlite database.
# DATABASE_URL=postgres://familypulse:CHANGE_ME@localhost:5432/familypulse
PGLITE_DIR=./data/pglite
# Max PostgreSQL connections per process (default 5; use 2-3 on small hosts).
# DB_POOL_MAX=5

# Public URL of the web app: used for the CSRF origin check and for links in emails.
# Defaults to RENDER_EXTERNAL_URL on Render, else http://localhost:5173.
# APP_ORIGIN=https://familypulse.example.com

SESSION_TTL_DAYS=30
# Secure cookies default to true in production. Set TRUST_PROXY=true behind a reverse proxy.
# COOKIE_SECURE=true
# TRUST_PROXY=true

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
LOG_LEVEL=info

# In production, serve the built web app from the API (single origin):
# WEB_DIST_DIR=../web/dist

# Email: console (dev: prints to the log) | smtp | disabled
EMAIL_TRANSPORT=console
# SMTP_URL=smtps://user:password@smtp.example.com:465
EMAIL_FROM=FamilyPulse <no-reply@familypulse.local>

# RATE_LIMIT_ENABLED=true
ALERT_SWEEP_MINUTES=60

# Public demo: load the fictional sample household, lock demo accounts, reset when older than N hours.
# DEMO_MODE=true
# DEMO_RESET_HOURS=24

# Bank-data aggregator (not integrated; setting these only flips the status shown in Settings).
# AGGREGATOR_CLIENT_ID=
# AGGREGATOR_SECRET=
